# Copy to .env (git-ignored) and fill in. Everything here is optional.
# Google Gemini key for the AI narrative report and chat; without it a rule-based fallback is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Backend port (default 8000). If you change it, set REACT_APP_API_URL in frontend-react/.env to match.
# STRUCTURALAI_PORT=8010
